	"scripts": {
		"legacy-start": "react-scripts --openssl-legacy-provider start",
		"start": "cross-env NODE_OPTIONS=\"--max_old_space_size=32768 --openssl-legacy-provider\" craco start",
		"cypress:start": "cross-env CYPRESS=true yarn start",
		"legacy-build": "react-scripts build",
		"build": "cross-env NODE_OPTIONS=\"--max_old_space_size=32768 --openssl-legacy-provider\" craco build",
		"legacy-test": "react-scripts --openssl-legacy-provider test",
		"test": "cross-env NODE_OPTIONS=\"--max_old_space_size=32768 --openssl-legacy-provider\" craco test",
		"eject": "react-scripts --openssl-legacy-provider eject",
		"cy:component": "cross-env NODE_OPTIONS=\"--max_old_space_size=32768 --openssl-legacy-provider\" cypress run --component --browser chrome",
		"ci:cy-login": "cross-env START_SERVER_AND_TEST_INSECURE=1 start-server-and-test cypress:start http://localhost:3000 \"cypress run --spec 'cypress/e2e/login.cy.js' --browser chrome\"",
		"cy:open": "yarn run ci:cy-login && cross-env NODE_OPTIONS=\"--max_old_space_size=32768 --openssl-legacy-provider\" cypress open",
		"ci:cy-login-component": "yarn ci:cy-login && yarn cy:component",
		"lint": "eslint . --fix --max-warnings=0",
		"format": "prettier . --write",
		"prepare": "husky install",
		"cy:run": "node cypress/scripts/logCypressHistory/index.js",
		"analyze": "source-map-explorer 'build/static/js/*.js'"
	},
	"eslintConfig": {
		"extends": "react-app"
	},
	"browser": {
		"fs": false
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
