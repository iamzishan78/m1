.selectedWell.wellStatus\n                    : \"--\"}\n                </Typography>\n              </div>\n              </Button>\n\n              <Button\n                className={classes.button}\n                onClick = {() => {handleOpenDetails()}}\n                              >\n              <div className={classes.iconContainer}>\n                <ProductionIcon\n                  htmlColor=\"black\"\n                  viewBox=\"0 0 39 31\"\n                  fontSize=\"large\"\n                />\n                <Typography\n                  align=\"center\"\n                  className={classes.text1}\n                  variant=\"subtitle2\"\n                >\n                  Last 12 Prod\n                </Typography>\n                <Typography\n                  align=\"center\"\n                  className={classes.text2}\n                  variant=\"caption\"\n                >\n                  {`${formatBOE(stateApp.selectedWell.lastTwelveMonthBOE)} BOE`}\n                </Typography>\n              </div>\n              </Button>\n\n              <Button\n                className={classes.button}\n                onClick = {() => {handleOpenDetails(true)}}\n                              >\n              <div className={classes.iconContainer}>\n                <OwnershipIcon\n                  htmlColor=\"black\"\n                  viewBox=\"0 0 45 31\"\n                  fontSize=\"large\"\n                />\n                <Typography\n                  align=\"center\"\n                  className={classes.text1}\n                  variant=\"subtitle2\"\n                >\n                  Owners\n                </Typography>\n                <Typography\n                  align=\"center\"\n                  className={classes.text2}\n                  variant=\"caption\"\n                >\n                  {stateApp.selectedWell.ownerCount\n                    ? stateApp.selectedWell.ownerCount\n                    : \"--\